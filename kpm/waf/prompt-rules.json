{
  "fallback": "shell",
  "rules": [
    {
      "id": "ai",
      "match": [
        "grok",
        "codex",
        "claude",
        "gemini",
        "aider",
        "opencode",
        "copilot",
        "hermes",
        "kiro",
        "amp",
        "droid"
      ],
      "keys": [
        { "label": "y", "prompt": "y", "title": "Yes" },
        { "label": "n", "prompt": "n", "title": "No" },
        { "label": "1", "prompt": "1", "title": "Choice 1" },
        { "label": "2", "prompt": "2", "title": "Choice 2" },
        { "label": "3", "prompt": "3", "title": "Choice 3" },
        { "label": "Continue", "prompt": "Continue", "title": "Continue" },
        { "label": "C", "key": "C-c", "title": "Ctrl-C cancel" },
        { "label": "D", "key": "C-d", "title": "Ctrl-D" },
        { "label": "/clear", "slash": "/clear" },
        { "label": "/resume", "slash": "/resume" },
        { "label": "/compact", "slash": "/compact" },
        { "label": "/help", "slash": "/help" },
        { "label": "/exit", "slash": "/exit" }
      ]
    },
    {
      "id": "python",
      "match": ["python", "ipython", "ptpython"],
      "keys": [
        { "label": "C", "key": "C-c", "title": "KeyboardInterrupt" },
        { "label": "D", "key": "C-d", "title": "EOF" },
        { "label": "L", "key": "C-l", "title": "Clear" },
        { "label": "A", "key": "C-a", "title": "Start of line" },
        { "label": "E", "key": "C-e", "title": "End of line" },
        { "label": "K", "key": "C-k", "title": "Kill to end" },
        { "label": "U", "key": "C-u", "title": "Kill to start" },
        { "label": "W", "key": "C-w", "title": "Kill word" },
        { "label": "Y", "key": "C-y", "title": "Yank" },
        { "label": "R", "key": "C-r", "title": "Reverse search" }
      ]
    },
    {
      "id": "shell",
      "match": ["fish", "bash", "zsh", "sh", "dash", "ash"],
      "keys": [
        { "label": "C", "key": "C-c", "title": "Interrupt" },
        { "label": "D", "key": "C-d", "title": "EOF / delete" },
        { "label": "Z", "key": "C-z", "title": "Suspend" },
        { "label": "L", "key": "C-l", "title": "Clear screen" },
        { "label": "A", "key": "C-a", "title": "Start of line" },
        { "label": "E", "key": "C-e", "title": "End of line" },
        { "label": "K", "key": "C-k", "title": "Kill to end" },
        { "label": "U", "key": "C-u", "title": "Kill to start" },
        { "label": "W", "key": "C-w", "title": "Kill word" },
        { "label": "Y", "key": "C-y", "title": "Yank" },
        { "label": "R", "key": "C-r", "title": "Reverse search" },
        { "label": "T", "key": "C-t", "title": "Transpose" }
      ]
    }
  ]
}
